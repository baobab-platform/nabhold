NEXT_PUBLIC_SITE_URL=http://localhost:3000
BAOBAB_PULSE_API_URL=
BAOBAB_PULSE_API_TOKEN=
BAOBAB_PULSE_TIMEOUT_MS=5000
# Reviewed HTTPS CP origin only: no base path, query, fragment or URL credentials.
BAOBAB_CONTROL_PLANE_API_URL=
NABHOLD_DASHBOARD_PREVIEW=false
PAYLOAD_BASE_URL=
PAYLOAD_API_TOKEN=
PAYLOAD_REVALIDATE_SECRET=
PAYLOAD_TIMEOUT_MS=5000
NABHOLD_CONTENT_DEV_FALLBACK=false
# Release classes (NAB-GOLIVE-MP-001 §1.3). R0 (public site) is on unless set to "false".
# R1-R3 are off unless exactly "true" and require signed acceptance first.
NABHOLD_RELEASE_R0=true
NABHOLD_RELEASE_R1=false
NABHOLD_RELEASE_R2=false
NABHOLD_RELEASE_R3=false
# CP header/body deadline in milliseconds (1–60000; invalid values use 5000).
BAOBAB_CONTROL_PLANE_TIMEOUT_MS=5000
# Content-Security-Policy rollout: unset or "enforce" enforces; "report-only" only reports.
NABHOLD_CSP_MODE=
# Canonical host. In production set NEXT_PUBLIC_SITE_URL=https://nabhold.com and
# NABHOLD_CANONICAL_HOST=nabhold.com so www.nabhold.com redirects (308) to the apex.
# Leave NABHOLD_CANONICAL_HOST unset locally.
NABHOLD_CANONICAL_HOST=
# Canonical content (register G05). Off unless NABHOLD_CONTENT_SOURCE is exactly "capability" AND required context/estate/service settings below are set.
# When on, the five singleton keys come from content.entry.resolve; if it cannot answer, estate defaults are served.
NABHOLD_CONTENT_SOURCE=
NABHOLD_CONTENT_TENANT_ID=
NABHOLD_CONTENT_CONTEXT_ID=
# Optional content filter; not Tenant identity or a legal-actor mandate. Leave unset unless content needs this scope.
NABHOLD_CONTENT_LEGAL_ENTITY_ID=
NABHOLD_CONTENT_DIGITAL_ESTATE_ID=
NABHOLD_CONTENT_MARKET_ID=
NABHOLD_CONTENT_LOCALE=en-ZA
NABHOLD_CONTENT_TIMEOUT_MS=5000
# JSON map of service name to https origin, e.g. {"baobab-cms":"https://cms.example"}. A service not listed is refused.
NABHOLD_SERVICE_ORIGINS=
# G04B confidential session custody only; this does not enable executive login.
# Require a reviewed TLS Redis endpoint and a dedicated, prefix-scoped ACL.
NABHOLD_BFF_STORE_ENABLED=false
NABHOLD_BFF_REDIS_HOST=
NABHOLD_BFF_REDIS_PORT=
NABHOLD_BFF_REDIS_USERNAME=
NABHOLD_BFF_REDIS_PASSWORD=
# Optional private CA; otherwise use the operating system's trusted CAs.
NABHOLD_BFF_REDIS_CA_PEM=
# Secret-store JSON map of key IDs to 32-byte CSPRNG keys encoded as base64.
# One active key and at most two retiring keys. Never commit a populated value.
NABHOLD_BFF_STORE_KEYS_JSON=
NABHOLD_BFF_STORE_ACTIVE_KEY=
# Approved recovery namespace. Rotate with old workers/ACL credentials fenced.
NABHOLD_BFF_STORE_EPOCH=

# G04B-03 confidential OIDC source integration. No client is registered or
# credentials minted by these flags. Production activation remains blocked.
# Enable only behind an access-controlled TLS edge that overwrites Host and X-Forwarded-Host/Proto.
# Direct ingress must be blocked; false preserves direct HTTPS URL validation.
NABHOLD_OIDC_TRUST_PROXY=false
NABHOLD_OIDC_ENABLED=false
NABHOLD_OIDC_ENVIRONMENT=
NABHOLD_OIDC_ORIGIN=
NABHOLD_OIDC_ISSUER=
NABHOLD_OIDC_CLIENT_ID=
NABHOLD_OIDC_CLIENT_SECRET=
NABHOLD_OIDC_ID_TOKEN_ALGORITHM=RS256
NABHOLD_OIDC_INTROSPECTION_ENDPOINT=
NABHOLD_OIDC_CP_ORIGIN=
