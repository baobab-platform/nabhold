NEXT_PUBLIC_SITE_URL=http://localhost:3000
BAOBAB_PULSE_API_URL=
BAOBAB_PULSE_API_TOKEN=
BAOBAB_PULSE_TIMEOUT_MS=5000
BAOBAB_CONTROL_PLANE_API_URL=
NABHOLD_DASHBOARD_PREVIEW=false
PAYLOAD_BASE_URL=
PAYLOAD_API_TOKEN=
PAYLOAD_REVALIDATE_SECRET=
PAYLOAD_TIMEOUT_MS=5000
NABHOLD_CONTENT_DEV_FALLBACK=false
# Release classes (NAB-GOLIVE-MP-001 §1.3). R0 (public site) is on unless set to "false".
# R1-R3 are off unless exactly "true" and require signed acceptance first.
NABHOLD_RELEASE_R0=true
NABHOLD_RELEASE_R1=false
NABHOLD_RELEASE_R2=false
NABHOLD_RELEASE_R3=false
BAOBAB_CONTROL_PLANE_TIMEOUT_MS=5000
# Content-Security-Policy rollout: unset or "enforce" enforces; "report-only" only reports.
NABHOLD_CSP_MODE=
# Canonical host. In production set NEXT_PUBLIC_SITE_URL=https://nabhold.com and
# NABHOLD_CANONICAL_HOST=nabhold.com so www.nabhold.com redirects (308) to the apex.
# Leave NABHOLD_CANONICAL_HOST unset locally.
NABHOLD_CANONICAL_HOST=
# Canonical content (register G05). Off unless NABHOLD_CONTENT_SOURCE is exactly "capability" AND everything below is set.
# When on, the five singleton keys come from content.entry.resolve; if it cannot answer, estate defaults are served.
NABHOLD_CONTENT_SOURCE=
NABHOLD_CONTENT_TENANT_ID=
NABHOLD_CONTENT_CONTEXT_ID=
NABHOLD_CONTENT_LEGAL_ENTITY_ID=
NABHOLD_CONTENT_DIGITAL_ESTATE_ID=
NABHOLD_CONTENT_MARKET_ID=
NABHOLD_CONTENT_LOCALE=en-ZA
NABHOLD_CONTENT_TIMEOUT_MS=5000
# JSON map of service name to https origin, e.g. {"baobab-cms":"https://cms.example"}. A service not listed is refused.
NABHOLD_SERVICE_ORIGINS=
