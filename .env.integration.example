# Template only: NOT runnable until Infrastructure supplies the private handoff.
# Copy to .env.integration.local, chmod 600, populate EVERY empty required value.
# Pass its absolute path as NABHOLD_INTEGRATION_ENV_FILE. Do not source this file.
# This profile is identity/session smoke only, not CMS/ERP or INT-03 acceptance.
NABHOLD_INTEGRATION_PROFILE=keycloak-identity-smoke
NABHOLD_INTEGRATION_SYNTHETIC=true
# Exact 40-character source revisions from the running lab; never "main"/tags.
NABHOLD_INTEGRATION_INFRASTRUCTURE_SHA=
NABHOLD_INTEGRATION_IAM_SHA=
NABHOLD_INTEGRATION_CP_SHA=
NABHOLD_INTEGRATION_SHARED_SHA=
# HTTPS origin, without trailing slash; reachable by browser AND BFF.
NEXT_PUBLIC_SITE_URL=
NABHOLD_OIDC_ORIGIN=
# Enable only behind an access-controlled TLS edge that overwrites Host and X-Forwarded-Host/Proto.
# Direct ingress must be blocked; false preserves direct HTTPS URL validation.
NABHOLD_OIDC_TRUST_PROXY=false
NABHOLD_OIDC_ENABLED=true
NABHOLD_OIDC_ENVIRONMENT=integration
NABHOLD_OIDC_ISSUER=
# Dedicated IAM-governed Nabhold client, not an INT-02 generic admin client.
NABHOLD_OIDC_CLIENT_ID=
NABHOLD_OIDC_CLIENT_SECRET=
NABHOLD_OIDC_ID_TOKEN_ALGORITHM=RS256
NABHOLD_OIDC_INTROSPECTION_ENDPOINT=
NABHOLD_OIDC_CP_ORIGIN=
BAOBAB_CONTROL_PLANE_API_URL=
# Private CA file must exist inside every Node process/container using it.
# Chromium additionally needs this CA installed in its own trust store.
NODE_EXTRA_CA_CERTS=
NABHOLD_BFF_STORE_ENABLED=true
NABHOLD_BFF_REDIS_HOST=
NABHOLD_BFF_REDIS_PORT=
NABHOLD_BFF_REDIS_USERNAME=
NABHOLD_BFF_REDIS_PASSWORD=
# Optional literal multiline PEM in single quotes (not a backslash-n string).
NABHOLD_BFF_REDIS_CA_PEM=
# JSON string in single quotes; values are random canonical base64 32-byte keys.
NABHOLD_BFF_STORE_KEYS_JSON=
NABHOLD_BFF_STORE_ACTIVE_KEY=
NABHOLD_BFF_STORE_EPOCH=
# Disposable human already mapped to an active CP Principal, never superadmin.
NABHOLD_INTEGRATION_USERNAME=
NABHOLD_INTEGRATION_PASSWORD=
NABHOLD_INTEGRATION_PRINCIPAL_ID=
NABHOLD_CONTENT_DEV_FALLBACK=false
NABHOLD_DASHBOARD_PREVIEW=false
# Identity-only smoke; canonical CMS profile will add governed context/bindings.
NABHOLD_CONTENT_SOURCE=
NABHOLD_CANONICAL_HOST=
NABHOLD_RELEASE_R0=true
NABHOLD_RELEASE_R1=false
NABHOLD_RELEASE_R2=false
NABHOLD_RELEASE_R3=false
