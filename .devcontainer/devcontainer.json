{
  "name": "Nabhold Digital Estate — private GHCR/npm",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.5.1-frontend@sha256:388d604293fc6a2046d1abb9c7b80b32e78c6003636b091d1e9c7c827e34766d",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "TZ": "Africa/Johannesburg",
    "NEXT_TELEMETRY_DISABLED": "1",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Nabhold Next.js",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent",
    "visibility": "private"
  },
  "updateContentCommand": "node --test scripts/codespaces/*.node.mjs",
  "postCreateCommand": "node scripts/codespaces/bootstrap.mjs && baobab-verify --contract && pnpm typecheck && pnpm test",
  "postStartCommand": "node scripts/codespaces/configure-private-npm.mjs",
  "waitFor": "postCreateCommand",
  "customizations": {
    "codespaces": {
      "repositories": {
        "baobab-platform/baobab-dev": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "baobab-platform/shared": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      },
      "openFiles": [
        "README.md",
        "docs/architecture.md"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "redhat.vscode-yaml",
        "mikestead.dotenv"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "[javascript][typescript][typescriptreact][javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  }
}
