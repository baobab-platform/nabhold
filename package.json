{
  "name": "@nabhold/digital-estate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.functional.config.ts",
    "verification:prepare": "node --experimental-strip-types scripts/prepare-legal-verification.mjs",
    "onboarding:operators:check": "node --experimental-strip-types scripts/check-onboarding-operators.mjs",
    "acceptance:protected": "node --experimental-strip-types scripts/run-protected-acceptance.mjs",
    "test:auth-store": "vitest run --config vitest.auth-store.config.ts",
    "integration:check": "node --experimental-strip-types scripts/integration/run.mjs check",
    "dev:integration": "node --experimental-strip-types scripts/integration/run.mjs dev",
    "test:e2e:integration": "node --experimental-strip-types scripts/integration/run.mjs test",
    "observe:executive-context": "node --experimental-strip-types scripts/observe-executive-navigation.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test:e2e:lighthouse": "playwright test tests/e2e/performance-budget.spec.ts --project=chromium --workers=1",
    "test:e2e:a11y": "playwright test tests/e2e/landing-page.accessibility.spec.ts --project=chromium --workers=1",
    "test:e2e:visual": "playwright test tests/e2e/landing-page.visual.spec.ts --project=chromium --workers=1",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@redis/client": "6.3.1",
    "@tailwindcss/postcss": "4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "@baobab-platform/experience-tokens": "0.3.1",
    "@baobab-platform/experience-geo-core": "0.3.1"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
